# Copy to .env and fill in. .env is git-ignored.

# PostgreSQL + PostGIS (docker-compose.yml)
POSTGRES_DB=oliveye
POSTGRES_USER=oliveye
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# openEO (Copernicus Data Space Ecosystem).
# Interactive work uses OIDC device login (no secrets here); the refresh token is stored by the
# openeo client in your user config dir. Fill these only if you later create client credentials
# for automated jobs (Phase 2+).
OPENEO_BACKEND_URL=openeo.dataspace.copernicus.eu
# OPENEO_AUTH_CLIENT_ID=
# OPENEO_AUTH_CLIENT_SECRET=
